# Query questions :- 

CUSTOMER
              ID
              FIRST_NAME (VARCHAR2)
              LAST_NAME (VARCHAR2)
              ADDRESS
              ...
 
RECEIPT
              ID (ID)
              CUSTOMER_ID,
              PURCHASE_DATE (TIMESTAMP),
              WORKER_ID,
              CREDIT_CARD_ID (ID)
              ...
 
PURCHASED_ITEMS
              ID
              RECEIPT_ID,
              PRODUCT_ID,
              PRODUCT_SALE_AMOUNT
              ...


1. Find the total sales we've made this year.
2. Find the most expensive and least expensive product we've sold this year.
3. Find the total number of sales made by each associate this year.
4. Find the customer who has spend the most money of all time.

```
CREATE TABLE CUSTOMER (
    ID            NUMBER PRIMARY KEY,
    FIRST_NAME    VARCHAR2(50) NOT NULL,
    LAST_NAME     VARCHAR2(50) NOT NULL,
    ADDRESS       VARCHAR2(200)
);

CREATE SEQUENCE CUSTOMER_SEQ START WITH 1 INCREMENT BY 1;

CREATE OR REPLACE TRIGGER CUSTOMER_TRG
BEFORE INSERT ON CUSTOMER
FOR EACH ROW
BEGIN
    IF :NEW.ID IS NULL THEN
        :NEW.ID := CUSTOMER_SEQ.NEXTVAL;
    END IF;
END;
/

CREATE TABLE RECEIPT (
    ID              NUMBER PRIMARY KEY,
    CUSTOMER_ID     NUMBER NOT NULL,
    PURCHASE_DATE   TIMESTAMP DEFAULT SYSTIMESTAMP,
    WORKER_ID       NUMBER,
    CREDIT_CARD_ID  NUMBER,
    CONSTRAINT fk_receipt_customer 
        FOREIGN KEY (CUSTOMER_ID) REFERENCES CUSTOMER(ID)
);

CREATE SEQUENCE RECEIPT_SEQ START WITH 1 INCREMENT BY 1;

CREATE OR REPLACE TRIGGER RECEIPT_TRG
BEFORE INSERT ON RECEIPT
FOR EACH ROW
BEGIN
    IF :NEW.ID IS NULL THEN
        :NEW.ID := RECEIPT_SEQ.NEXTVAL;
    END IF;
END;
/

CREATE TABLE PURCHASED_ITEMS (
    ID                  NUMBER PRIMARY KEY,
    RECEIPT_ID          NUMBER NOT NULL,
    PRODUCT_ID          NUMBER NOT NULL,
    PRODUCT_SALE_AMOUNT NUMBER(10,2) NOT NULL,
    CONSTRAINT fk_items_receipt 
        FOREIGN KEY (RECEIPT_ID) REFERENCES RECEIPT(ID)
);

CREATE SEQUENCE PURCHASED_ITEMS_SEQ START WITH 1 INCREMENT BY 1;

CREATE OR REPLACE TRIGGER PURCHASED_ITEMS_TRG
BEFORE INSERT ON PURCHASED_ITEMS
FOR EACH ROW
BEGIN
    IF :NEW.ID IS NULL THEN
        :NEW.ID := PURCHASED_ITEMS_SEQ.NEXTVAL;
    END IF;
END;
/

